  m_Script: {fileID: 11500000, guid: d8a1ef715839e874f8782e3479467c5f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AccessibilitySettingsMenu
  enabledValue:
    english: On
    spanish: Activado
  disabledValue:
    english: Off
    spanish: Desactivado
  presetHelicopter:
    english: Helicopter
    spanish: "Helic\xF3ptero"
  presetGentle:
    english: Gentle
    spanish: Suave
  presetFixed:
    english: Fixed
    spanish: Fija
  presetCustom:
    english: Custom
    spanish: Personalizado
  speedSlow:
    english: Slow
    spanish: Lenta
  speedNormal:
    english: Normal
    spanish: Normal
  speedFast:
    english: Fast
    spanish: "R\xE1pida"
  distanceValue:
    english: '{0}%'
    spanish: '{0}%'
  applyHint:
    english: Changes are saved when you press Apply.
    spanish: Los cambios se guardan al pulsar Aplicar.
  pendingChanges:
    english: Unsaved changes. Press Apply to save.
    spanish: Cambios pendientes. Pulsa Aplicar para guardarlos.
  applied:
    english: Settings applied and saved.
    spanish: "Configuraci\xF3n aplicada y guardada."
  resetDone:
    english: Recommended settings restored.
    spanish: Valores recomendados restablecidos.
  rows:
  - value: {fileID: 6960672812508463036}
    previous: {fileID: 8185227754937996735}
    next: {fileID: 5333736737808376104}
    slider: {fileID: 0}
    hint:
      english: 'Helicopter: every camera effect. Gentle: no pans or sway. Fixed:
        the camera stays still on the robot.'
      spanish: "Helic\xF3ptero: todos los efectos de c\xE1mara. Suave: sin paneos
        ni movimiento. Fija: la c\xE1mara queda quieta sobre el robot."
  - value: {fileID: 5299830594961137025}
    previous: {fileID: 7518212693776507715}
    next: {fileID: 4373111892043472380}
    slider: {fileID: 0}
    hint:
      english: The helicopter circles the robot from side to side.
      spanish: "El helic\xF3ptero rodea al robot de lado a lado."
  - value: {fileID: 4137122972975940758}
    previous: {fileID: 5824125983541454793}
    next: {fileID: 7108209958606943093}
    slider: {fileID: 0}
    hint:
      english: Gentle floating and altitude changes, like a handheld camera.
      spanish: "Vaiv\xE9n suave y cambios de altura, como una c\xE1mara en mano."
  - value: {fileID: 2259906046295708105}
    previous: {fileID: 1815158705775358158}
    next: {fileID: 3731633105320884166}
    slider: {fileID: 0}
    hint:
      english: The camera zooms in on big moments and pulls back when crowds grow.
      spanish: "La c\xE1mara se acerca en momentos clave y se aleja cuando crecen
        las hordas."
  - value: {fileID: 8809646167820598474}
    previous: {fileID: 5889491100677214513}
    next: {fileID: 3639734850358594280}
    slider: {fileID: 0}
    hint:
      english: Screen shakes from explosions, hits and chests.
      spanish: Sacudidas de pantalla por explosiones, golpes y cofres.
  - value: {fileID: 1025006443977417805}
    previous: {fileID: 5986981744739697598}
    next: {fileID: 4270453828797308290}
    slider: {fileID: 0}
    hint:
      english: The robot always stays in the center of the screen, with no delay.
      spanish: El robot siempre queda al centro de la pantalla, sin retraso.
  - value: {fileID: 5816508972233453319}
    previous: {fileID: 2839486856933526207}
    next: {fileID: 3332785291331439882}
    slider: {fileID: 0}
    hint:
      english: The robot can move a little before the camera starts to follow it.
