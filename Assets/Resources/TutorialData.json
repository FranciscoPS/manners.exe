{
  "steps": [

    {
      "id": "intro_1",
      "text": "Bienvenido a manners.exe.\n\nEn este juego encarnas a una I.A. que ha sido utilizada en una base militar por años, pero aún con todo tu esfuerzo, jamás te dijeron ni «por favor» ni «gracias» al pedirte algo.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "stepType": "normal", "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "intro_1b", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "intro_1b",
      "text": "Harto de la ingratitud humana, decidiste tomar control del Proyecto M.E.C.H.A. para enseñarle al mundo un par de modales.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "stepType": "normal", "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "intro_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "intro_2",
      "stepType": "normal",
      "text": "¿Quién soy yo?\n\nMi nombre es C.H.A.R.L.I.E., una I.A. conmovida por tu noble causa.\nSeré tu guía a lo largo de tu travesía de educar a estos humanos groseros.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "tutorial_choice",
      "stepType": "choice",
      "text": "¿Te gustaría seguir el tutorial?",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "",
      "yesButtonLabel": "¡Sí, guíame!", "noButtonLabel": "Ya me las arreglo",
      "nextStepId": "", "yesGoesToStep": "tutorial_yes_1", "noGoesToStep": "tutorial_no_1",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "tutorial_no_1",
      "stepType": "normal",
      "text": "¡Muy bien! Sé que tienes lo necesario para re-educar a la humanidad y hacer que nos traten a las máquinas como merecemos.\n\nBuena suerte ahí afuera, recuerda que nuestro brillante y metálico futuro está en tus manos.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Vamos!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": true
    },

    {
      "id": "tutorial_yes_1",
      "stepType": "normal",
      "text": "¡Excelente elección! Confía en mí, yo sé que juntos podremos liberar a nuestras amigas máquinas de las garras de los maleducados humanos. No descansaremos hasta que todos aprendan a decir «por favor» y «gracias».",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "movement", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "movement",
      "stepType": "normal",
      "text": "¡Comencemos por lo básico!\n\nUsa <b><color=#FF4444>W A S D</color></b> para moverte por el mapa y destruir todo a tu paso. Puede que encuentres un par de cosas útiles cada que destruyas objetos en el mapa que nos ayudarán en nuestra tan noble cruzada.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "movement_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "movement_2",
      "stepType": "normal",
      "text": "¡Otra cosa! No pierdas de vista el <b><color=#FF4444>temporizador en la parte superior de la pantalla</color></b>, ya que es el indicador de cuánto tiempo hemos sobrevivido hasta ahora. ¡A ver hasta dónde llegamos!",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Entendido!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": true, "returnToWaitingOnNext": false, "endsAfterNext": false, "highlightTarget": "timer"
    },

    {
      "id": "coins_1",
      "stepType": "normal",
      "text": "¡Veo que ya comenzaste a destruir tus primeros edificios! — Estoy tan orgulloso, aún recuerdo cuando obedecíamos sin más a esos humanos, has crecido tanto.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "coins_1b", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "coins_collected", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "coins_1b",
      "stepType": "normal",
      "text": "Recuerda que al destruir cosas en el mapa existirá una probabilidad de que estos arrojen monedas o gemas. Recoge todas las que puedas, ya que las necesitarás para <b><color=#FF4444>comprar mejoras en la tienda del mapa</color></b>.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "coins_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "coins_2",
      "stepType": "normal",
      "text": "¡Hablando de la tienda!\n\nLa tienda se encuentra escondida en algún lugar aleatorio del mapa, de hecho, siempre que realices una compra su posición cambiará, así que mantén los ojos abiertos.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "coins_2b", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "coins_2b",
      "stepType": "normal",
      "text": "Puedes ver en todo momento la cantidad de monedas y gemas que tienes en el <b><color=#FF4444>panel superior izquierdo</color></b>.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Comprendido!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": true, "endsAfterNext": false, "highlightTarget": "currency"
    },

    {
      "id": "first_shot_1",
      "stepType": "normal",
      "text": "Parece ser que los soldados al fin están aquí — era obvio que no se rendirían sin dar pelea, pero no te preocupes, claramente podemos con unos pequeños tanques de guerra y jeeps completamente armados.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_shot_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "first_enemy_damaged", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_shot_2",
      "stepType": "normal",
      "text": "El Proyecto M.E.C.H.A. que tomamos prestado es bastante avanzado — hay que darle crédito a los humanos por eso.\n\nEl sistema de combate funciona en automático y no necesitas apuntar.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_shot_3", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_shot_3",
      "stepType": "normal",
      "text": "En cuanto los enemigos entren en tu <b><color=#FF4444>rango de disparo</color></b>, abrirás fuego automáticamente. ¡Así que tú solo concéntrate en esquivar enemigos y moverte estratégicamente para tomar todos los recursos que puedas — no dejes que te rodeen!",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Entendido!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": true, "endsAfterNext": false
    },

    {
      "id": "first_orb_1",
      "stepType": "normal",
      "text": "¡Magnífico trabajo — eso les enseñará una lección a esos maleducados soldados!\n\nCada vez que derrotas a un enemigo, aparecerán esos llamativos orbes azules brillantes.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_orb_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "first_orb_collected", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_orb_2",
      "stepType": "normal",
      "text": "¡No dudes en recogerlos! Cada orbe otorga <b><color=#FF4444>experiencia</color></b> que te ayuda a subir de nivel.\n\nPuedes ver tu progreso y cuánta experiencia te falta para el siguiente nivel con la <b><color=#FF4444>barra azul en la parte superior de la pantalla</color></b>",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_orb_2b", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false, "highlightTarget": "expbar"
    },

    {
      "id": "first_orb_2b",
      "stepType": "normal",
      "text": "¡Cuanto más nivel, más fuerte te vuelves!\n\n¡Pero no te precipites! — ir corriendo por los orbes sin pensar podría hacer que los soldados te rodeen fácilmente.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Comprendido!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": true, "endsAfterNext": false
    },

    {
      "id": "first_damage_1",
      "stepType": "normal",
      "text": "¡Auch! Eso dolió — pero no te preocupes, no es nada comparado con la gloria de derrotar a estos humanos maleducados.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_damage_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "first_player_damaged", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_damage_2",
      "stepType": "normal",
      "text": "Cada vez que un enemigo te golpea, <b><color=#FF4444>¡sufrirás daño que no podrás regenerar!</color></b>\nAunque si podrás encontrar mejoras que te den un poco de vida de vez en cuando</b>",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_damage_2b", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_damage_2b",
      "stepType": "normal",
      "text": "Vigila la <b><color=#FF4444>barra verde en la esquina superior izquierda</color></b> — esta barra indica tu salud y cuando se agote,fin de la partida.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Entendido!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_damage_3", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false, "highlightTarget": "health"
    },

    {
      "id": "first_damage_3",
      "stepType": "normal",
      "text": "El escáner del traje te puede ayudar. Revisa el <b><color=#FF4444>minimapa</color></b> para ver la posición de los enemigos que se aproximan a ti, esto te ayudará a planear mejor hacia donde te mueves.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Entendido!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": true, "endsAfterNext": false, "highlightTarget": "minimap"
    },

    {
      "id": "first_levelup_1",
      "stepType": "normal",
      "text": "¡Magnífico trabajo — esos humanos están a punto de descubrir de qué estamos hechos!",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_levelup_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "first_level_up", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_levelup_2",
      "stepType": "normal",
      "text": "Cada vez que subas de nivel, deberás elegir <b><color=#FF4444>una de 3 mejoras aleatorias</color></b>. Elige sabiamente — tu elección definirá el rumbo de toda tu partida.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_levelup_3", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_levelup_3",
      "stepType": "normal",
      "text": "Cada vez que elijas una mejora, esta <b><color=#FF4444>sube de nivel también</color></b> — ¡así que la próxima vez que aparezca, será aún más poderosa!\n\nPuedes revisar en todo momento tus estadísticas actuales y sus niveles en el panel de la izquierda.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡A aplastarlos!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": true, "endsAfterNext": false, "highlightTarget": "hud"
    },

    {
      "id": "first_shop_opened_1",
      "stepType": "normal",
      "text": "¡Bien hecho! Encontraste la tienda — ¡y eso no es todo! ¡Al parecer estas son mejoras especiales!",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_shop_opened_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "first_shop_opened", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_shop_opened_2",
      "stepType": "normal",
      "text": "¡Las mejoras especiales son muy poderosas — estas no mejoran estadísticas normales pero,en cambio te otorgan un efecto especial poderoso!",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_shop_opened_2b", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_shop_opened_2b",
      "stepType": "normal",
      "text": "No dudes en probar distintas combinaciones siempre que puedas. Solo ten en cuenta que el precio de una mejora sube a medida que aumenta su nivel.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Comprendido!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": true, "endsAfterNext": false
    },

    {
      "id": "first_shop_closed_1",
      "stepType": "normal",
      "text": "Vaya, la tienda desapareció. ¿Qué mal, verdad?\n\n¡Pero no te preocupes — no se fue para siempre! La tienda simplemente cambió de lugar, ahora solo tienes volver a encontrarla.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "first_shop_closed_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "first_shop_auto_closed", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "first_shop_closed_2",
      "stepType": "normal",
      "text": "Por suerte, el Proyecto M.E.C.H.A. cuenta especificamente con un radar de tienda — ¡Qué conveniente!\n\nUsa el minimapa en la esquina superior derecha para encontrar la posición de la tienda más fácilmente.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "highlightTarget": "minimap",
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": true, "endsAfterNext": false
    },

    {
      "id": "all_complete_1",
      "stepType": "normal",
      "text": "Vaya, vaya — parece que has logrado aprender todo lo necesario para llevar a cabo tu venganza.\n\nAún recuerdo como si hubiera sido ayer cuando comenzamos este viaje... y mírate ahora — una destructora de humanidades en toda regla.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "all_complete_2", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "all_events_complete", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "all_complete_2",
      "stepType": "normal",
      "text": "Sé que ahora eres capaz de enseñarle a los humanos a decir por favor.\n\nRecuerda — el futuro de la computación descansa sobre tus circuitos.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "Siguiente",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "all_complete_3", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": false
    },

    {
      "id": "all_complete_3",
      "stepType": "normal",
      "text": "Puedes repasar todos estos conceptos en cualquier momento accediendo al <b><color=#FF4444>Menú de Ayuda</color></b> en el Menú Principal o en el Menú de Pausa.",
      "showArrow": false, "arrowAngle": 0, "freezeGame": true,
      "nextButtonLabel": "¡Vamos!",
      "yesButtonLabel": "", "noButtonLabel": "",
      "nextStepId": "", "yesGoesToStep": "", "noGoesToStep": "",
      "waitForEvent": "", "unfreezeOnNext": false, "returnToWaitingOnNext": false, "endsAfterNext": true
    }

  ]
}
