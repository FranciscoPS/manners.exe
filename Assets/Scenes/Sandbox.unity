    highlightTarget: 
  - id: coins_1b
    message:
      english: 'Destroyed objects may drop coins or gems. Collect as many as you
        can: you need them to <b><color=#FF4444>buy upgrades at the shop</color></b>.'
      spanish: "Recuerda que al destruir cosas en el mapa existir\xE1 una probabilidad
        de que estos arrojen monedas o gemas. Recoge todas las que puedas, ya que
        las necesitar\xE1s para <b><color=#FF4444>comprar mejoras en la tienda del
        mapa</color></b>."
    showArrow: 0
    arrowAngle: 0
    freezeGame: 1
    stepType: normal
    nextLabel:
