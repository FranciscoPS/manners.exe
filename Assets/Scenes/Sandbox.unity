    highlightTarget: 
  - id: coins_2
    message:
      english: 'Speaking of the shop!


        It is hidden somewhere on the map.
        It moves after every purchase, so keep your eyes open.'
      spanish: "\xA1Hablando de la tienda!\n\nLa tienda se encuentra escondida en
        alg\xFAn lugar aleatorio del mapa, de hecho, siempre que realices una compra
        su posici\xF3n cambiar\xE1, as\xED que mant\xE9n los ojos abiertos."
