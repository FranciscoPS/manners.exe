    highlightTarget: 
  - id: chest_1
    message:
      english: 'A <b><color=#FF4444>chest</color></b> will appear in the center of
        the map every minute.


        It contains powerful effects that will help
        you during the match.'
      spanish: "Toma en cuenta que cada minuto aparecer\xE1 un <b><color=#FF4444>cofre</color></b>
        en el centro del mapa.\n\nEste cofre contiene efectos poderosos que seguramente
        te ser\xE1n de utilidad en tu partida."
    showArrow: 0
