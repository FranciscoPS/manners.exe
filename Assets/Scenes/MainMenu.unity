    el intervalo entre cada tiro y permiti\xE9ndote lanzar m\xE1s balas en menos
    tiempo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2d79f4c45cdc44a4090f37491c18c1f6, type: 2}
